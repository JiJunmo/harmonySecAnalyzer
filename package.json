{
  "name": "agent-workflow-platform",
  "version": "3.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "tsc -b",
    "check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "agent": "pnpm build && node apps/cli/dist/main.js",
    "web": "pnpm build && node apps/server/dist/main.js",
    "project-profiler": "tsx packages/harmony-audit/src/project/profiler-cli.ts",
    "atlas-indexer": "tsx packages/harmony-audit/src/project/atlas-indexer-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
