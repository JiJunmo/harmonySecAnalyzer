{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "capabilities"],
  "properties": {
    "schema_version": {"const": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["capability_id", "title", "domain", "entry_types", "status"],
        "properties": {
          "capability_id": {"type": "string", "pattern": "^CAP-[A-Z0-9-]+$"},
          "title": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "entry_types": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "status": {"enum": ["enabled", "planned", "deferred"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
