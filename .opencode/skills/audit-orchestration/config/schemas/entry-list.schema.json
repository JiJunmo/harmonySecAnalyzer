{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony-sec.local/schemas/entry-list-v1.json",
  "type": "object",
  "required": ["entry_list", "excluded_candidates", "unresolved_candidates", "coverage_gaps"],
  "properties": {
    "entry_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_id", "project_candidate_ids"],
        "properties": {
          "entry_id": {"type": "string", "minLength": 1},
          "project_candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
          "atlas_query_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "excluded_candidates": {"type": "array", "items": {"type": "object"}},
    "unresolved_candidates": {"type": "array", "items": {"type": "object"}},
    "coverage_gaps": {"type": "array", "items": {"type": "object"}}
  }
}
