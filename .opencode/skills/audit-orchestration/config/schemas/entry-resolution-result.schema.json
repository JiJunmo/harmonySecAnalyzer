{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entry Resolution Result",
  "type": "object",
  "required": ["task_id", "entries", "excluded_candidates", "gaps"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["entry_key", "entry_type", "symbol", "discriminator", "transport", "external_reachability", "project_candidate_ids", "evidence_refs"],
        "properties": {
          "entry_key": {"type": "string", "minLength": 1},
          "entry_type": {"enum": ["ipc_transaction", "common_event", "deeplink", "want", "provider", "web", "exported_ability"]},
          "component": {"type": ["string", "null"]},
          "symbol": {"type": "string", "minLength": 1},
          "discriminator": {"type": "object", "minProperties": 1},
          "transport": {"enum": ["ipc", "common_event", "uri", "want", "provider", "web"]},
          "external_reachability": {"enum": ["reachable", "guarded", "unknown"]},
          "project_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": true
      }
    },
    "excluded_candidates": {"$ref": "#/$defs/dispositions"},
    "gaps": {"$ref": "#/$defs/dispositions"},
    "evidence": {"$ref": "#/$defs/evidenceList"}
  },
  "$defs": {
    "dispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_candidate_ids", "reason", "evidence_refs"],
        "properties": {
          "project_candidate_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "evidenceList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_id", "kind", "source", "summary"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1},
          "summary": {"type": "string", "minLength": 1},
          "location": {"type": ["string", "null"]},
          "content_ref": {"type": ["string", "null"]},
          "sha256": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
