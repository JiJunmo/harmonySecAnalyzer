{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony-sec.local/schemas/discovery-plan-v1.json",
  "type": "object",
  "required": ["schema_version", "units"],
  "properties": {
    "schema_version": {"const": 1},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit_id", "status"],
        "properties": {
          "unit_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["planned", "running", "completed", "excluded", "unresolved", "atlas_gap"]},
          "entry_candidate_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "entry_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "atlas_query_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    }
  }
}
