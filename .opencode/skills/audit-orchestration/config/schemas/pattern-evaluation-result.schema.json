{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "flow_id", "assessments"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "flow_id": {"type": "string", "minLength": 1},
    "assessments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "pattern_id", "verdict", "boundary", "reason", "evidence_refs"],
        "properties": {
          "capability_id": {"type": "string", "minLength": 1},
          "pattern_id": {"type": "string", "minLength": 1},
          "verdict": {"enum": ["supported", "refuted", "not_applicable", "evidence_gap"]},
          "boundary": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
