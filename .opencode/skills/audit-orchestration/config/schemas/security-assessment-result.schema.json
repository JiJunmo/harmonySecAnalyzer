{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "path_id", "summary", "assessments", "evidence"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "path_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "assessments": {"type": "array", "items": {"$ref": "#/$defs/assessment"}},
    "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}}
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "kind", "source", "summary"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "content_ref": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "exploitability": {
      "type": "object",
      "required": ["externally_reachable", "attacker_controlled", "sink_reached", "guard_bypassed_or_absent", "boundary_violated", "concrete_impact"],
      "properties": {
        "externally_reachable": {"type": "boolean"},
        "attacker_controlled": {"type": "boolean"},
        "sink_reached": {"type": "boolean"},
        "guard_bypassed_or_absent": {"type": "boolean"},
        "boundary_violated": {"type": "boolean"},
        "concrete_impact": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "businessIntent": {
      "type": "object",
      "required": ["is_public_api", "declared_or_inferred_purpose", "allowed_controls", "evidence_refs"],
      "properties": {
        "is_public_api": {"type": "boolean"},
        "declared_or_inferred_purpose": {"type": "string", "minLength": 1},
        "allowed_controls": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      },
      "additionalProperties": false
    },
    "securityBoundary": {
      "type": "object",
      "required": ["type", "expected_boundary", "violation", "reason", "evidence_refs"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "expected_boundary": {"type": "string", "minLength": 1},
        "violation": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      },
      "additionalProperties": false
    },
    "guard": {
      "type": "object",
      "required": ["type", "location", "protects", "applies_before_sink", "validated_property", "effectiveness", "bypass_analysis", "evidence_refs"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "protects": {"type": "string", "minLength": 1},
        "applies_before_sink": {"type": "boolean"},
        "validated_property": {"type": "string", "minLength": 1},
        "effectiveness": {"enum": ["effective", "bypassable", "irrelevant", "unknown"]},
        "bypass_analysis": {
          "type": "object",
          "required": ["known_bypass", "checked_cases", "reason"],
          "properties": {
            "known_bypass": {"type": "boolean"},
            "checked_cases": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
            "reason": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      },
      "additionalProperties": false
    },
    "counterEvidence": {
      "type": "object",
      "required": ["kind", "reason", "evidence_refs"],
      "properties": {
        "kind": {"enum": ["effective_guard", "business_intent", "not_attacker_controlled", "sink_not_reached", "no_boundary_violation", "no_concrete_impact"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      },
      "additionalProperties": false
    },
    "rootCause": {
      "type": "object",
      "required": ["operation_location", "branch", "boundary", "controlled_property"],
      "properties": {
        "operation_location": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1},
        "controlled_property": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "assessment": {
      "type": "object",
      "required": ["capability_id", "pattern_id", "category", "operation_fact_id", "classification", "title", "exploitability", "root_cause", "guards", "counter_evidence", "evidence_refs"],
      "properties": {
        "capability_id": {"type": ["string", "null"]},
        "pattern_id": {"type": ["string", "null"]},
        "category": {"type": "string", "minLength": 1},
        "operation_fact_id": {"type": ["string", "null"]},
        "classification": {"enum": ["confirmed_vulnerability", "protected_exposure", "benign_business_flow", "insufficient_evidence", "residual_risk"]},
        "title": {"type": "string", "minLength": 1},
        "exploitability": {"$ref": "#/$defs/exploitability"},
        "business_intent": {"$ref": "#/$defs/businessIntent"},
        "security_boundary": {"$ref": "#/$defs/securityBoundary"},
        "guards": {"type": "array", "items": {"$ref": "#/$defs/guard"}},
        "counter_evidence": {"type": "array", "items": {"$ref": "#/$defs/counterEvidence"}},
        "impact": {"type": "string", "minLength": 1},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "cwe": {"type": "string", "pattern": "^CWE-[0-9]+$"},
        "poc": {"type": "string", "minLength": 1},
        "demotion_reason": {"type": "string", "minLength": 1},
        "evidence_gap": {"type": "string", "minLength": 1},
        "root_cause": {"$ref": "#/$defs/rootCause"},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"}
      },
      "allOf": [
        {
          "if": {"properties": {"classification": {"const": "confirmed_vulnerability"}}, "required": ["classification"]},
          "then": {
            "required": ["security_boundary", "impact", "severity", "cwe", "poc"],
            "properties": {
              "exploitability": {"properties": {
                "externally_reachable": {"const": true},
                "attacker_controlled": {"const": true},
                "sink_reached": {"const": true},
                "guard_bypassed_or_absent": {"const": true},
                "boundary_violated": {"const": true},
                "concrete_impact": {"const": true}
              }},
              "security_boundary": {"properties": {"violation": {"const": true}}}
            }
          },
          "else": {"required": ["demotion_reason"]}
        },
        {
          "if": {"properties": {"classification": {"enum": ["residual_risk", "insufficient_evidence"]}}, "required": ["classification"]},
          "then": {"required": ["evidence_gap"]}
        },
        {
          "if": {"properties": {"classification": {"const": "protected_exposure"}}, "required": ["classification"]},
          "then": {"properties": {"guards": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"classification": {"const": "benign_business_flow"}}, "required": ["classification"]},
          "then": {"required": ["business_intent"]}
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
