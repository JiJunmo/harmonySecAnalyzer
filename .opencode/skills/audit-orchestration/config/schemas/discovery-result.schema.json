{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmony-sec.local/schemas/discovery-result-v1.json",
  "title": "Per-unit attack surface discovery result",
  "type": "object",
  "required": [
    "task_id", "unit_id", "status", "resolved_symbols", "atlas_query_ids",
    "gaps", "entry_list", "excluded_candidates", "unresolved_candidates",
    "coverage_gaps", "danger_seed_list", "query_evidence"
  ],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "unit_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["completed", "excluded", "atlas_gap"]},
    "resolved_symbols": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "atlas_query_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "gaps": {"type": "array"},
    "entry_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["project_candidate_ids", "entry_function", "entry_function_file"],
        "properties": {
          "type": {"type": "string", "minLength": 1},
          "project_candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "entry_function": {"type": "string", "minLength": 1},
          "entry_function_file": {"type": "string", "minLength": 1},
          "atlas_query_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "trigger_variants": {"type": "array", "items": {"type": "object"}},
          "ipc_stub_class": {"type": "string", "minLength": 1},
          "ipc_descriptor": {"type": "string", "minLength": 1},
          "transaction_code": {"type": ["string", "integer"]},
          "publication_point": {"type": "string", "minLength": 1},
          "publication_kind": {"type": "string", "minLength": 1},
          "remote_reachable": {"type": "boolean"}
        },
        "allOf": [{
          "if": {"properties": {"type": {"const": "ipc_stub_transaction"}}, "required": ["type"]},
          "then": {"required": ["ipc_stub_class", "ipc_descriptor", "transaction_code", "publication_point", "publication_kind", "remote_reachable"]}
        }],
        "anyOf": [
          {"required": ["component_id"]},
          {"required": ["ability"]}
        ]
      }
    },
    "excluded_candidates": {"$ref": "#/$defs/candidateDispositions"},
    "unresolved_candidates": {"$ref": "#/$defs/candidateDispositions"},
    "coverage_gaps": {"$ref": "#/$defs/candidateDispositions"},
    "danger_seed_list": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "sink_role"],
        "properties": {
          "category": {"type": "string", "minLength": 1},
          "sink_role": {"enum": ["terminal", "intermediate", "unknown"]},
          "symbol": {"type": "string"},
          "location": {"type": "string"},
          "atlas_query_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "anyOf": [
          {"required": ["symbol"]},
          {"required": ["location"]}
        ]
      }
    },
    "query_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query_id", "outcome"],
        "properties": {
          "query_id": {"type": "string", "minLength": 1},
          "unit_id": {"type": "string", "minLength": 1},
          "tool": {"type": "string", "minLength": 1},
          "outcome": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "candidateDispositions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "project_candidate_id": {"type": "string", "minLength": 1},
          "project_candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "anyOf": [
          {"required": ["project_candidate_id"]},
          {"required": ["project_candidate_ids"]}
        ]
      }
    }
  }
}
