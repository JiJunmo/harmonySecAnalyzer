{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["task_id", "entry_id", "summary", "coverage", "operation_groups", "component_calls"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "entry_id": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "required": ["entry_status", "external_entry_status", "confirmed_external_candidate_ids", "entry_notes", "entry_symbols_checked", "operation_sites_checked", "unresolved_targets"],
      "properties": {
        "entry_status": {
          "enum": ["confirmed", "excluded", "uncertain"],
          "description": "A real executable component input is proven, ruled out, or not established. Internal-only inputs can be confirmed; this is not a vulnerability verdict."
        },
        "external_entry_status": {
          "enum": ["confirmed", "excluded", "uncertain"],
          "description": "A non-component_scope external input is proven, ruled out, or not established. It is independent of internal component reachability."
        },
        "confirmed_external_candidate_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "entry_notes": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "entry_symbols_checked": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "operation_sites_checked": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "unresolved_targets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exploration_summary": {
          "type": "object",
          "required": ["status", "rounds", "total_nodes", "completed_nodes", "stopped_nodes", "gap_nodes", "max_depth"],
          "properties": {
            "status": {
              "enum": ["complete", "partial"],
              "description": "Runtime-derived coverage, not vulnerability validity: complete means no known exploration/entry gap; partial means known gaps or uncertain entry assessment. Agents do not author this field."
            },
            "rounds": {"type": "integer", "minimum": 0},
            "total_nodes": {"type": "integer", "minimum": 1},
            "completed_nodes": {"type": "integer", "minimum": 0},
            "stopped_nodes": {"type": "integer", "minimum": 0},
            "gap_nodes": {"type": "integer", "minimum": 0, "description": "Unprocessed nodes closed by runtime limits, not the total coverage-gap count. Analysis failures inside processed segments are listed in coverage.unresolved_targets."},
            "max_depth": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "operation_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "component_calls": {"type": "array", "items": {"$ref": "#/$defs/componentCall"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind", "source", "summary"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "content_ref": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "evidenceList": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "fact": {
      "type": "object",
      "required": ["fact_key", "type", "body", "evidence"],
      "properties": {
        "fact_key": {"type": "string", "minLength": 1},
        "type": {"enum": ["entrypoint", "reachability", "control", "transform", "security_check", "operation", "dead_end"]},
        "body": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "branch": {
      "type": "object",
      "required": ["condition", "locations", "evidence"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "locations": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "securityCheck": {
      "type": "object",
      "required": ["type", "location", "protects", "subject_kind", "validated_property", "behavior", "evidence"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "protects": {"type": "string", "minLength": 1},
        "validated_property": {"type": "string", "minLength": 1},
        "subject_kind": {
          "enum": ["origin_principal", "immediate_caller", "transferred_property", "resource_owner", "security_boundary", "unknown"],
          "description": "Classify by the checked value's provenance, not coincidental identity equality: caller-identity APIs use immediate_caller even for direct external calls; independently authenticated original identity uses origin_principal; unverified transferred claims use transferred_property. Resource ownership uses resource_owner; other boundary policy uses security_boundary; unknown means not established."
        },
        "behavior": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "principalTransition": {
      "type": "object",
      "required": ["caller_principal", "callee_observed_principal", "origin_binding", "authority_used", "evidence"],
      "properties": {
        "caller_principal": {"type": "string", "minLength": 1},
        "callee_observed_principal": {"type": "string", "minLength": 1},
        "origin_binding": {
          "enum": ["preserved", "replaced_by_caller", "not_observable", "unknown"],
          "description": "Select preserved if the original identity is verifiably available; otherwise replaced_by_caller if only the immediate caller's identity is verifiably available; otherwise not_observable if the channel is proven to expose neither identity reliably; unknown if not established."
        },
        "authority_used": {
          "enum": ["origin", "source_component", "system", "none", "unknown"],
          "description": "Actual authority used: original actor, current intermediary component, proven system authority, proven no relevant authority, or insufficient evidence. Calling a system API alone does not imply system authority."
        },
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "parameterMapping": {
      "type": "object",
      "required": ["source_property", "target_property", "control_state", "transform"],
      "properties": {
        "source_property": {"type": "string", "minLength": 1},
        "target_property": {"type": "string", "minLength": 1},
        "control_state": {
          "enum": ["preserved", "constrained", "constant", "unknown"],
          "description": "Select constant if independence from attacker input is proven; otherwise constrained if an explicit restriction on the input's security-relevant values is proven; otherwise preserved if influence is proven without such restriction; unknown if not established. Copying preserves upstream constraints. Constrained does not imply safe."
        },
        "transform": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "invocationControl": {
      "type": "object",
      "required": ["control_state", "condition", "evidence"],
      "properties": {
        "control_state": {
          "enum": ["preserved", "constrained", "independent", "unknown"],
          "description": "Select independent if invocation is proven independent of this input; otherwise constrained if input controls invocation under a proven restrictive condition; otherwise preserved if this control is proven without such restriction; unknown if not established. Constant arguments do not make invocation independent."
        },
        "condition": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "componentCall": {
      "type": "object",
      "required": ["call_key", "target_component_id", "target_symbol", "transport", "call_location", "condition", "invocation_control", "parameter_mappings", "principal_transition", "security_checks", "evidence"],
      "properties": {
        "call_key": {"type": "string", "minLength": 1},
        "target_component_id": {"type": "string", "minLength": 1},
        "target_symbol": {"type": "string", "minLength": 1},
        "transport": {"type": "string", "minLength": 1},
        "call_location": {"type": "string", "minLength": 1},
        "condition": {"type": "string", "minLength": 1},
        "invocation_control": {"$ref": "#/$defs/invocationControl"},
        "parameter_mappings": {"type": "array", "items": {"$ref": "#/$defs/parameterMapping"}},
        "principal_transition": {"$ref": "#/$defs/principalTransition"},
        "security_checks": {"type": "array", "items": {"$ref": "#/$defs/securityCheck"}},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "effectHypothesis": {
      "type": "object",
      "required": ["claim", "basis_evidence", "missing_proofs"],
      "properties": {
        "claim": {"type": "string", "minLength": 1},
        "basis_evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "missing_proofs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "required": ["external_actor", "intended_behavior", "protected_assets", "direct_observed_effect", "effect_hypotheses", "evidence"],
      "properties": {
        "external_actor": {"type": "string", "minLength": 1},
        "intended_behavior": {"type": "string", "minLength": 1},
        "protected_assets": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "direct_observed_effect": {"type": ["string", "null"], "minLength": 1},
        "effect_hypotheses": {"type": "array", "items": {"$ref": "#/$defs/effectHypothesis"}},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "availability": {
      "type": "object",
      "required": ["resource_or_failure", "attacker_influence", "limit_or_amplification", "exception_or_isolation", "repeat_trigger", "affected_scope", "recovery", "evidence"],
      "properties": {
        "resource_or_failure": {"type": "string", "minLength": 1},
        "attacker_influence": {"type": "string", "minLength": 1},
        "limit_or_amplification": {"type": "string", "minLength": 1},
        "exception_or_isolation": {"type": "string", "minLength": 1},
        "repeat_trigger": {"type": "string", "minLength": 1},
        "affected_scope": {"type": "string", "minLength": 1},
        "recovery": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidenceList"}
      },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["group_key", "category", "capability_id", "title", "operation", "controlled_properties", "context", "branches", "facts", "security_checks"],
      "properties": {
        "group_key": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "capability_id": {"type": ["string", "null"]},
        "title": {"type": "string", "minLength": 1},
        "operation": {
          "type": "object",
          "required": ["body", "location", "evidence"],
          "properties": {
            "body": {"type": "string", "minLength": 1},
            "location": {"type": "string", "minLength": 1},
            "evidence": {"$ref": "#/$defs/evidenceList"}
          },
          "additionalProperties": false
        },
        "controlled_properties": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "context": {"$ref": "#/$defs/context"},
        "availability": {"$ref": "#/$defs/availability"},
        "branches": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/branch"}},
        "facts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/fact"}},
        "security_checks": {"type": "array", "items": {"$ref": "#/$defs/securityCheck"}}
      },
      "allOf": [{
        "if": {"properties": {"capability_id": {"const": "CAP-DOS-001"}}},
        "then": {"required": ["availability"], "properties": {"category": {"const": "availability"}}}
      }],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
