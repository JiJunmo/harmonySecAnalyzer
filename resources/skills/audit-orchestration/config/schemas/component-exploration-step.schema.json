{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["work_id","pause_requested","result","ranges","transitions"],
  "properties": {
    "work_id": {"type":"string","minLength":1},
    "pause_requested": {"type":"boolean"},
    "result": {"$ref":"#/$defs/result"},
    "ranges": {"type":"array","items":{"$ref":"#/$defs/range"}},
    "transitions": {"type":"array","items":{"$ref":"#/$defs/transition"}},
    "entry_assessment": {"$ref":"#/$defs/entryAssessment"}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind","source","summary"],
      "properties": {
        "kind": {"type":"string","minLength":1},
        "source": {"type":"string","minLength":1},
        "summary": {"type":"string","minLength":1},
        "location": {"type":["string","null"]},
        "content_ref": {"type":["string","null"]},
        "sha256": {"type":["string","null"]}
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["target","reason","evidence"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "Exact unresolved expression from Atlas, or a source-located target when source inspection fails."
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "Which anchored call and binding/dispatch source locations were inspected and why they still did not resolve the target. Atlas failure or capacity limits alone are not source failures."
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref":"#/$defs/evidence"},
          "contains": {
            "anyOf": [
              {"required":["location"],"properties":{"location":{"type":"string","minLength":1}}},
              {"required":["content_ref"],"properties":{"content_ref":{"type":"string","minLength":1}}}
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "entryAssessment": {
      "type": "object",
      "required": ["entry_status","external_entry_status","confirmed_external_candidate_ids","component_summary"],
      "properties": {
        "entry_status": {
          "enum": ["confirmed","excluded","uncertain"],
          "description": "confirmed: a real executable component input exists, including internal input; excluded: evidence rules out all candidates; uncertain: evidence is insufficient. Not a vulnerability verdict."
        },
        "external_entry_status": {
          "enum": ["confirmed","excluded","uncertain"],
          "description": "Whether non-component_scope candidates establish a real external input: proven, ruled out, or not established. An internal-only component can be confirmed/excluded across the two entry fields."
        },
        "confirmed_external_candidate_ids": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "component_summary": {"type":"string","minLength":1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "description": "New source evidence supporting the updated component-wide assessment; required for updates after entry discovery.",
          "items": {"$ref":"#/$defs/evidence"},
          "contains": {
            "anyOf": [
              {"required":["location"],"properties":{"location":{"type":"string","minLength":1}}},
              {"required":["content_ref"],"properties":{"content_ref":{"type":"string","minLength":1}}}
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["type","body","evidence"],
      "properties": {
        "type": {"enum":["entrypoint","reachability","control","transform","security_check","operation","dead_end"]},
        "body": {"type":"string","minLength":1},
        "location": {"type":["string","null"]},
        "evidence": {"type":"array","items":{"$ref":"#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "required": ["qualified_name","file_path","line","kind"],
      "properties": {
        "qualified_name": {"type":"string","minLength":1},
        "file_path": {"type":["string","null"]},
        "line": {"type":["integer","null"],"minimum":1},
        "kind": {"type":"string","minLength":1}
      },
      "additionalProperties": false
    },
    "controlledProperty": {
      "type": "object",
      "required": ["name","control_state"],
      "properties": {
        "name": {"type":"string","minLength":1},
        "control_state": {
          "enum": ["preserved","constrained","constant","unknown"],
          "description": "Select constant if independence from attacker input is proven; otherwise constrained if an explicit restriction on the input's security-relevant values is proven; otherwise preserved if influence is proven without such restriction; unknown if not established. Copying preserves upstream constraints. Constrained does not imply safe."
        }
      },
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "required": ["origin","immediate","origin_binding","authority"],
      "properties": {
        "origin": {"type":"string","minLength":1},
        "immediate": {"type":"string","minLength":1},
        "origin_binding": {
          "enum": ["preserved","replaced_by_caller","not_observable","unknown"],
          "description": "Select preserved if the original identity is verifiably available; otherwise replaced_by_caller if only the immediate caller's identity is verifiably available; otherwise not_observable if the channel is proven to expose neither identity reliably; unknown if not established."
        },
        "authority": {
          "enum": ["origin","source_component","system","none","unknown"],
          "description": "Actual authority used: original actor, current intermediary component, proven system authority, proven no relevant authority, or insufficient evidence. Calling a system API alone does not imply system authority."
        }
      },
      "additionalProperties": false
    },
    "securityState": {
      "type": "object",
      "required": ["controlled_properties","principal","security_checks"],
      "properties": {
        "controlled_properties": {"type":"array","items":{"$ref":"#/$defs/controlledProperty"}},
        "principal": {"$ref":"#/$defs/principal"},
        "security_checks": {
          "type": "array",
          "description": "Checks already traversed on this branch. Inherit existing references or reference evidenced checks from this step. The runtime derives stable identities; do not invent IDs.",
          "items": {"$ref":"#/$defs/securityCheckReference"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "securityCheckReference": {
      "type": "object",
      "required": ["location","subject_kind","validated_property"],
      "properties": {
        "location": {"type":"string","minLength":1},
        "subject_kind": {
          "enum": ["origin_principal","immediate_caller","transferred_property","resource_owner","security_boundary","unknown"],
          "description": "Classify by the checked value's provenance, not coincidental identity equality: caller-identity APIs use immediate_caller even for direct external calls; independently authenticated original identity uses origin_principal; unverified transferred claims use transferred_property. Resource ownership uses resource_owner; other boundary policy uses security_boundary; unknown means not established."
        },
        "validated_property": {
          "type": "string",
          "minLength": 1,
          "description": "Use the checked source expression/property, not a paraphrased label."
        }
      },
      "additionalProperties": false
    },
    "securityCheck": {
      "type": "object",
      "required": ["type","location","protects","subject_kind","validated_property","behavior","evidence"],
      "properties": {
        "type": {"type":"string","minLength":1},
        "location": {"type":"string","minLength":1},
        "protects": {"type":"string","minLength":1},
        "subject_kind": {"$ref":"#/$defs/securityCheckReference/properties/subject_kind"},
        "validated_property": {"$ref":"#/$defs/securityCheckReference/properties/validated_property"},
        "behavior": {"type":"string","minLength":1},
        "evidence": {"type":"array","minItems":1,"items":{"$ref":"#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "span": {
      "type": "object",
      "required": ["start","end"],
      "properties": {"start":{"type":"integer","minimum":1},"end":{"type":"integer","minimum":1}},
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["symbol","start","end","kind"],
      "properties": {
        "symbol": {"$ref":"#/$defs/symbol"},
        "start": {"type":"integer","minimum":1},
        "end": {"type":"integer","minimum":1},
        "kind": {"enum":["function","block","choice","call","join","exit"]},
        "start_column": {
          "type": "integer",
          "minimum": 1,
          "description": "Column anchor for distinct blocks on the same source line; omitted means 1."
        },
        "end_column": {"type":"integer","minimum":1}
      },
      "additionalProperties": false
    },
    "termination": {
      "type": "object",
      "required": ["kind","reason","evidence"],
      "properties": {
        "kind": {
          "enum": ["return","throw","component_boundary","platform_boundary","third_party_boundary","security_influence_ended"]
        },
        "reason": {"type":"string","minLength":1},
        "evidence": {"type":"array","items":{"$ref":"#/$defs/evidence"},"minItems":1}
      },
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "required": ["summary","checked","termination","facts","security_checks","operation_groups","component_calls","gaps"],
      "properties": {
        "summary": {"type":"string","minLength":1},
        "checked": {"type":"array","items":{"$ref":"#/$defs/span"}},
        "termination": {"anyOf":[{"type":"null"},{"$ref":"#/$defs/termination"}]},
        "facts": {"type":"array","items":{"$ref":"#/$defs/fact"}},
        "security_checks": {"type":"array","items":{"$ref":"#/$defs/securityCheck"}},
        "operation_groups": {"type":"array","items":{"type":"object"}},
        "component_calls": {"type":"array","items":{"type":"object"}},
        "gaps": {"type":"array","items":{"$ref":"#/$defs/gap"}}
      },
      "additionalProperties": false
    },
    "range": {
      "type": "object",
      "required": ["ref","scope","state","conditions","wait_for","result"],
      "properties": {
        "ref": {"type":"string","minLength":1},
        "scope": {"$ref":"#/$defs/scope"},
        "state": {"$ref":"#/$defs/securityState"},
        "conditions": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "wait_for": {"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
        "result": {"anyOf":[{"type":"null"},{"$ref":"#/$defs/result"}]}
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["from","to","relation","condition","evidence"],
      "properties": {
        "from": {"type":"string","minLength":1},
        "to": {"type":"string","minLength":1},
        "relation": {"enum":["sequence","branch","call","callback","return","exception","reuse","loop"]},
        "condition": {"type":"string","minLength":1},
        "evidence": {"type":"array","items":{"$ref":"#/$defs/evidence"},"minItems":1}
      },
      "additionalProperties": false
    }
  },
  "description": "Range-based exploration. $current refers to the leased work. Local range refs or existing work IDs identify transition endpoints. Record all local branches and call continuations; result=null queues work. Checked spans plus delegated local ranges must cover the current scope. Only the runtime owns work status."
}
