{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "node_id",
    "work_type",
    "pause_requested",
    "resume",
    "summary",
    "atlas_queries",
    "resolved_relations",
    "analyzed_symbols",
    "facts",
    "security_checks",
    "operation_groups",
    "component_calls",
    "successors",
    "gaps"
  ],
  "properties": {
    "node_id": {"type": "string", "minLength": 1},
    "work_type": {"enum": ["entry_discovery", "function_analysis"]},
    "pause_requested": {
      "type": "boolean",
      "description": "Request a fresh context after saving this segment. Not a coverage or node status. Known unfinished targets must already be saved in successors; the runtime continues any queued work next round."
    },
    "resume": {
      "description": "Unfinished work inside the current function, not a call or a gap. Save its exact source position, remaining work and security state. null means this segment has no unfinished local work beyond the declared successors/gaps.",
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["location", "remaining_work", "state"],
          "properties": {
            "location": {"type": "string", "minLength": 1, "description": "Source-relative file:line[:column] of the next unexamined statement or branch. Do not change the function symbol's declaration location."},
            "remaining_work": {"type": "string", "minLength": 1, "description": "What has been checked and which statements/branches remain. Must let the next round resume without restarting the function."},
            "state": {"$ref": "#/$defs/securityState"}
          },
          "additionalProperties": false
        }
      ]
    },
    "summary": {"type": "string", "minLength": 1},
    "stop_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "return_or_throw",
        "component_boundary",
        "platform_boundary",
        "third_party_boundary",
        "security_influence_ended"
      ],
      "description": "Optional explanation of the current segment's normal terminal boundary. Does not control node/task status or stop other successors. Analysis failures belong only in gaps."
    },
    "entry_assessment": {"$ref": "#/$defs/entryAssessment"},
    "atlas_queries": {
      "type": "array",
      "items": {"$ref": "#/$defs/atlasQuery"}
    },
    "resolved_relations": {
      "type": "array",
      "description": "Call/data relations accepted for this step, proven by Atlas or bounded source inspection.",
      "items": {"$ref": "#/$defs/resolvedRelation"},
      "uniqueItems": true
    },
    "analyzed_symbols": {
      "type": "array",
      "description": "Ordinary call targets fully analyzed inside this step; they do not become persisted frontier nodes.",
      "items": {"$ref": "#/$defs/symbol"},
      "maxItems": 8,
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "items": {"$ref": "#/$defs/fact"}
    },
    "security_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/securityCheck"}
    },
    "operation_groups": {
      "type": "array",
      "items": {"type": "object"}
    },
    "component_calls": {
      "type": "array",
      "items": {"type": "object"}
    },
    "successors": {
      "type": "array",
      "description": "Known targets: stop_reason=null means unfinished work to queue; a normal boundary reason means do not expand. No separate decision/status field. Unknown targets belong in gaps.",
      "items": {"$ref": "#/$defs/successor"},
      "maxItems": 32
    },
    "gaps": {
      "type": "array",
      "description": "The only place to declare analysis failures, including their target, reason and evidence. Every Atlas unresolved expression must be source-resolved or have a gap with that exact target. Unexamined work belongs in successors.",
      "items": {"$ref": "#/$defs/gap"},
      "uniqueItems": true
    }
  },
  "allOf": [
    {
      "if": {"properties": {"work_type": {"const": "entry_discovery"}}},
      "then": {"required": ["entry_assessment"], "properties": {"resume": {"type": "null"}}},
      "else": {"properties": {"entry_assessment": {"required": ["evidence"]}}}
    }
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["kind", "source", "summary"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "content_ref": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "gap": {
      "type": "object",
      "required": ["target", "reason", "evidence"],
      "properties": {
        "target": {"type": "string", "minLength": 1, "description": "Exact unresolved expression from Atlas, or a source-located target when source inspection fails."},
        "reason": {"type": "string", "minLength": 1, "description": "What was attempted and why resolution failed. Capacity limits are not source failures."},
        "evidence": {
          "type": "array", "minItems": 1,
          "items": {"$ref": "#/$defs/evidence"},
          "contains": {
            "anyOf": [
              {"required": ["location"], "properties": {"location": {"type": "string", "minLength": 1}}},
              {"required": ["content_ref"], "properties": {"content_ref": {"type": "string", "minLength": 1}}}
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "entryAssessment": {
      "type": "object",
      "required": [
        "entry_status",
        "external_entry_status",
        "confirmed_external_candidate_ids",
        "component_summary"
      ],
      "properties": {
        "entry_status": {
          "enum": ["confirmed", "excluded", "uncertain"],
          "description": "confirmed: a real executable component input exists, including internal input; excluded: evidence rules out all candidates; uncertain: evidence is insufficient. Not a vulnerability verdict."
        },
        "external_entry_status": {
          "enum": ["confirmed", "excluded", "uncertain"],
          "description": "Whether non-component_scope candidates establish a real external input: proven, ruled out, or not established. An internal-only component can be confirmed/excluded across the two entry fields."
        },
        "confirmed_external_candidate_ids": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "component_summary": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array", "minItems": 1,
          "description": "New source evidence supporting the updated component-wide assessment; required for updates after entry discovery.",
          "items": {"$ref": "#/$defs/evidence"},
          "contains": {
            "anyOf": [
              {"required": ["location"], "properties": {"location": {"type": "string", "minLength": 1}}},
              {"required": ["content_ref"], "properties": {"content_ref": {"type": "string", "minLength": 1}}}
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "atlasQuery": {
      "type": "object",
      "required": ["tool", "source_symbol", "target_symbols", "unresolved_targets"],
      "properties": {
        "tool": {"enum": ["search", "symbol", "calls", "explore", "path", "trace"]},
        "source_symbol": {"type": ["string", "null"]},
        "target_symbols": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "unresolved_targets": {
          "type": "array",
          "description": "Only targets this Atlas query actually failed to resolve, not calls left unexamined because of budget or context capacity.",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "resolvedRelation": {
      "type": "object",
      "required": [
        "source_symbol",
        "target_symbol",
        "relation",
        "resolved_by",
        "mechanism",
        "unresolved_ref",
        "reason",
        "evidence"
      ],
      "properties": {
        "source_symbol": {"type": ["string", "null"], "minLength": 1},
        "target_symbol": {"type": "string", "minLength": 1},
        "relation": {
          "enum": ["call", "callback", "async_continuation", "branch", "data_flow", "component_boundary"]
        },
        "resolved_by": {"enum": ["atlas_index", "source_evidence"]},
        "mechanism": {
          "enum": [
            "atlas_index",
            "direct_source_call",
            "callback_binding",
            "function_assignment",
            "polymorphic_dispatch",
            "registry_dispatch",
            "name_dispatch",
            "inheritance_dispatch",
            "other_source_dispatch"
          ]
        },
        "unresolved_ref": {"type": ["string", "null"], "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"resolved_by": {"const": "source_evidence"}}},
          "then": {
            "properties": {
              "evidence": {"minItems": 2},
              "mechanism": {"not": {"const": "atlas_index"}}
            }
          },
          "else": {
            "properties": {
              "mechanism": {"const": "atlas_index"},
              "unresolved_ref": {"type": "null"}
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "fact": {
      "type": "object",
      "required": ["type", "body", "evidence"],
      "properties": {
        "type": {
          "enum": [
            "entrypoint",
            "reachability",
            "control",
            "transform",
            "security_check",
            "operation",
            "dead_end"
          ]
        },
        "body": {"type": "string", "minLength": 1},
        "location": {"type": ["string", "null"]},
        "evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence"}
        }
      },
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "required": ["qualified_name", "file_path", "line", "kind"],
      "properties": {
        "qualified_name": {"type": "string", "minLength": 1},
        "file_path": {"type": ["string", "null"]},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "kind": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "controlledProperty": {
      "type": "object",
      "required": ["name", "control_state"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "control_state": {
          "enum": ["preserved", "constrained", "constant", "unknown"],
          "description": "Select constant if independence from attacker input is proven; otherwise constrained if an explicit restriction on the input's security-relevant values is proven; otherwise preserved if influence is proven without such restriction; unknown if not established. Copying preserves upstream constraints. Constrained does not imply safe."
        }
      },
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "required": ["origin", "immediate", "origin_binding", "authority"],
      "properties": {
        "origin": {"type": "string", "minLength": 1},
        "immediate": {"type": "string", "minLength": 1},
        "origin_binding": {
          "enum": ["preserved", "replaced_by_caller", "not_observable", "unknown"],
          "description": "Select preserved if the original identity is verifiably available; otherwise replaced_by_caller if only the immediate caller's identity is verifiably available; otherwise not_observable if the channel is proven to expose neither identity reliably; unknown if not established."
        },
        "authority": {
          "enum": ["origin", "source_component", "system", "none", "unknown"],
          "description": "Actual authority used: original actor, current intermediary component, proven system authority, proven no relevant authority, or insufficient evidence. Calling a system API alone does not imply system authority."
        }
      },
      "additionalProperties": false
    },
    "securityState": {
      "type": "object",
      "required": ["controlled_properties", "principal", "security_checks"],
      "properties": {
        "controlled_properties": {
          "type": "array",
          "items": {"$ref": "#/$defs/controlledProperty"}
        },
        "principal": {"$ref": "#/$defs/principal"},
        "security_checks": {
          "type": "array",
          "description": "Checks already traversed on this branch. Inherit existing references or reference evidenced checks from this step. The runtime derives stable identities; do not invent IDs.",
          "items": {"$ref": "#/$defs/securityCheckReference"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "securityCheckReference": {
      "type": "object",
      "required": ["location", "subject_kind", "validated_property"],
      "properties": {
        "location": {"type": "string", "minLength": 1},
        "subject_kind": {
          "enum": ["origin_principal", "immediate_caller", "transferred_property", "resource_owner", "security_boundary", "unknown"],
          "description": "Classify by the checked value's provenance, not coincidental identity equality: caller-identity APIs use immediate_caller even for direct external calls; independently authenticated original identity uses origin_principal; unverified transferred claims use transferred_property. Resource ownership uses resource_owner; other boundary policy uses security_boundary; unknown means not established."
        },
        "validated_property": {"type": "string", "minLength": 1, "description": "Use the checked source expression/property, not a paraphrased label."}
      },
      "additionalProperties": false
    },
    "securityCheck": {
      "type": "object",
      "required": ["type", "location", "protects", "subject_kind", "validated_property", "behavior", "evidence"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "location": {"type": "string", "minLength": 1},
        "protects": {"type": "string", "minLength": 1},
        "subject_kind": {"$ref": "#/$defs/securityCheckReference/properties/subject_kind"},
        "validated_property": {"$ref": "#/$defs/securityCheckReference/properties/validated_property"},
        "behavior": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      },
      "additionalProperties": false
    },
    "successor": {
      "type": "object",
      "required": ["symbol", "relation", "condition", "stop_reason", "state"],
      "properties": {
        "symbol": {"$ref": "#/$defs/symbol"},
        "relation": {
          "enum": ["call", "callback", "async_continuation", "branch", "data_flow", "component_boundary"]
        },
        "condition": {"type": "string", "minLength": 1},
        "stop_reason": {
          "type": ["string", "null"],
          "description": "null: queue for analysis. A named boundary: record the target but do not expand. This is the sole routing input.",
          "enum": [
            null,
            "component_boundary",
            "platform_boundary",
            "third_party_boundary",
            "security_influence_ended"
          ]
        },
        "state": {"$ref": "#/$defs/securityState"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
